meta {
  name: Pending
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/threads/{{threadId}}/pending
  body: none
  auth: inherit
}

script:post-response {
  const approvals = res.getBody();
  if (res.status === 200) bru.setVar("approvalId", approvals[0]?.id ?? "");
}

tests {
  test("200 with a list", () => {
    expect(res.status).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

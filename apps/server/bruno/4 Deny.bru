meta {
  name: Deny
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/threads/{{threadId}}/resume
  body: json
  auth: inherit
}

body:json {
  {
    "answers": { "{{approvalId}}": false }
  }
}

tests {
  test("finishes the turn without running the command", () => {
    expect(res.status).to.equal(200);
    expect(String(res.getBody())).to.contain("event: done");
  });
}

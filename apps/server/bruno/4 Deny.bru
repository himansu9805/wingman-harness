meta {
  name: Deny
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/threads/{{threadId}}/resume
  body: json
  auth: inherit
}

body:json {
  {
    "answers": { "{{approvalId}}": false }
  }
}

script:post-response {
  if (res.status === 202) bru.setVar("runId", res.getBody().runId);
}

tests {
  test("accepts a background turn", () => {
    expect(res.status).to.equal(202);
    expect(res.getBody().runId).to.be.a("string");
  });
}

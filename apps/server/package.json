{
  "name": "@wingman/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "dev": "npm run build && concurrently -k -n swc,node \"swc src -d dist --strip-leading-paths --watch\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@wingman/core": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "chokidar": "^5.0.0"
  }
}

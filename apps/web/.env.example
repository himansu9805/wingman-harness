# Optional web-specific overrides. The web server also reads the repository's
# root .env, so an existing WINGMAN_API_TOKEN is reused automatically.
WINGMAN_API_URL=http://127.0.0.1:3000
WINGMAN_API_TOKEN=

# These are server-side values. Do not rename the token to VITE_*:
# Vite embeds VITE_* variables into browser JavaScript.
